# ==============================================================================
# Data Files (Raw, Processed, Caches, and Large Datasets)
# ==============================================================================
# Exclude data outputs and caches
data/raw/*
data/processed/*
data/synthetic/*
data/raw/dukascopy_cache/
data/raw/forexsb_chunks/

# Keep directory structure via .gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# Common data file extensions
*.csv
*.npy
*.npz
*.parquet
*.bi5
*.zst
*.h5
*.hdf5

